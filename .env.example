# Copy to .env and adjust. Never commit the real .env file.
# (Loaded automatically if python-dotenv is installed: pip install python-dotenv)

# Port the Flask server listens on (Render/Heroku set this for you)
PORT=5000

# --- Database -------------------------------------------------------------
# PRODUCTION: PostgreSQL connection string. When set, all accounts and data are stored there,
# so they survive restarts and redeploys (required on hosts with an ephemeral disk, e.g. Render free).
# Examples:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Leave empty for local development.
DATABASE_URL=

# LOCAL DEVELOPMENT: SQLite file used when DATABASE_URL is empty.
DB_PATH=./skillswapper.db

# Set to 1 to use sentence-transformers (all-MiniLM-L6-v2) embeddings for matching.
# Requires: pip install sentence-transformers. Leave 0 for the built-in lightweight embedding.
USE_ST=0
